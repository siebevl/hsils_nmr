spinsys {

channels 23Na
nuclei 23Na

shift 1 575.843p 0.0p 0.0 -112.02925533216725 124.39819533816295 -227.85088309995837
quadrupole 1 2 0.0 0.0 115.47406179351974 62.8879019478807 9.149304456609755

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     alpha0beta0
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
