spinsys {

channels 23Na
nuclei 23Na

shift 1 516.658p 179.39598816558959p 0.72905189658948 -25.060354279399522 156.44459880788992 -145.2991229614468
quadrupole 1 2 3790119.9501238707 0.4853822329590457 1.3120028279948919 55.30241955267222 75.68016664006879

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
