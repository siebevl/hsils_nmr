spinsys {

channels 23Na
nuclei 23Na

shift 1 616.5419999999999p 108.46399480635947p 0.42399684324939396 43.56707942602286 64.619907463615 39.44643778131144
quadrupole 1 2 -2916016.915479708 0.45696412959552174 281.5606604620875 16.810981688763974 -24.828188966846174

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
