spinsys {

channels 23Na
nuclei 23Na

shift 1 550.4749999999999p -92.9963455723938p 0.9589739525332507 -144.92500600931643 44.78018735130628 91.34684251697722
quadrupole 1 2 3157605.9166229237 0.47023502393758376 -0.29642415535824074 152.93990298862755 -131.8875743596202

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
