spinsys {

channels 23Na
nuclei 23Na

shift 1 608.8043333333334p 94.72744496201547p 0.6208928315907588 46.77808659195012 107.8569279513603 22.13714560389679
quadrupole 1 2 2292838.8096629963 0.31187085366535555 211.19542164366428 122.98765620002084 67.18702406003234

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
