spinsys {

channels 23Na
nuclei 23Na

shift 1 564.3126666666667p -80.53531865891128p 0.07200276189380811 17.931522076381846 111.02156380549397 -87.74310971457179
quadrupole 1 2 -4598163.708342676 0.06542993653855501 -38.866971126758656 37.80688083150714 126.60799674653066

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
