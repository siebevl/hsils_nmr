spinsys {

channels 23Na
nuclei 23Na

shift 1 664.927p 107.5196289734234p 0.7983315628538564 -35.405114119081354 30.893437345593114 -43.33667110745324
quadrupole 1 2 2977404.5199533864 0.748995372542585 40.78274120578375 71.28390053652932 -5.748402769941566

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
