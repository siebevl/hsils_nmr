spinsys {

channels 23Na
nuclei 23Na

shift 1 605.5313333333334p 41.39661956143156p 0.818453960246265 -73.83977466551674 74.14645276324036 -0.206205170175203
quadrupole 1 2 2627635.223901002 0.7062965508801814 74.25833808341332 97.07008139189165 -87.21194373846687

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
