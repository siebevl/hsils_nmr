spinsys {

channels 23Na
nuclei 23Na

shift 1 624.9606666666667p -83.65288457004552p 0.33245724225973167 -86.92940367621603 155.4015820074573 -105.95156820649194
quadrupole 1 2 -4000437.670216859 0.20920084463096483 166.1956505663333 108.05027536677481 150.81116442276573

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
