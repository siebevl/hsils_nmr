spinsys {

channels 23Na
nuclei 23Na

shift 1 567.7163333333333p -22.3605561416745p 0.7223382411820807 40.02121235114799 89.60564328419665 19.46565193709584
quadrupole 1 2 2756327.510632379 0.9696848619900359 34.67888654800811 92.0600578333169 -52.76297799877755

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
