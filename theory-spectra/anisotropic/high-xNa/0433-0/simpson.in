spinsys {

channels 23Na
nuclei 23Na

shift 1 515.3513333333334p 161.8815687411085p 0.7756871725345255 -89.89718270609319 132.0108570238938 -143.45627563228928
quadrupole 1 2 4195588.492113092 0.5958608377092814 82.51704068167935 103.06160873661361 39.410164377034135

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
