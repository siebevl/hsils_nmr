spinsys {

channels 23Na
nuclei 23Na

shift 1 561.442p -13.846776491648521p 0.7499833536493753 119.15482147850743 142.75067900300732 101.20119533329586
quadrupole 1 2 1673818.147500497 0.572026249331649 -71.78777172012308 55.40772262273347 -17.923856811631346

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
