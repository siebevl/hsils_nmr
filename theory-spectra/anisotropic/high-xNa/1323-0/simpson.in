spinsys {

channels 23Na
nuclei 23Na

shift 1 510.29466666666667p -207.0517347420361p 0.8504538347343045 63.38483371712377 109.3134283196527 9.528924930742999
quadrupole 1 2 2056650.9891172554 0.746713256373018 -31.183070188799544 169.2763785240195 46.690993575934534

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
