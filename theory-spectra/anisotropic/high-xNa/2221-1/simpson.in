spinsys {

channels 23Na
nuclei 23Na

shift 1 654.7496666666667p 169.45128856023598p 0.7776671754369413 -59.869379401708805 36.86761175574914 84.44002959943136
quadrupole 1 2 -3704423.2462355094 0.613051128116652 123.05124359013746 35.147941097580784 -13.330911993341996

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
