spinsys {

channels 23Na
nuclei 23Na

shift 1 553.364p 15.958097893023552p 0.3699270887268585 122.35169040689064 123.20548631828173 88.34658470911444
quadrupole 1 2 -3242953.2197709605 0.47774512393953383 121.49967384569351 120.9151495071282 -68.00288361162765

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
