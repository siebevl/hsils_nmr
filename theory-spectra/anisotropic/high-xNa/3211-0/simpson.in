spinsys {

channels 23Na
nuclei 23Na

shift 1 687.7126666666667p -140.97287343929762p 0.81413030262886 -40.97159206332219 87.6168512714268 60.147191000530974
quadrupole 1 2 816704.6198463975 0.549722524253078 -145.0923227336212 57.992831100779924 102.36614875945149

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
