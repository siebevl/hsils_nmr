spinsys {

channels 23Na
nuclei 23Na

shift 1 551.1016666666666p 15.19491909403617p 0.3748211545084333 57.80578408097211 80.88732465829574 -26.39498742825494
quadrupole 1 2 -3554320.4858574257 0.24933326126370117 55.00197327431746 90.42997921359269 24.079303254329204

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
