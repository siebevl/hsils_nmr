spinsys {

channels 23Na
nuclei 23Na

shift 1 614.016p 95.01763104086581p 0.5035927871887615 32.8063974904173 81.3272700448887 43.83333991849437
quadrupole 1 2 -2278450.801591823 0.702357782501917 121.84140697521265 96.76224732165193 -113.56449014093442

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
