spinsys {

channels 23Na
nuclei 23Na

shift 1 528.2526666666666p 49.018131075455926p 0.9561490526239174 -31.342465010781545 119.98621024071753 -260.30726548891374
quadrupole 1 2 3058434.9397688494 0.14679259881200485 -50.49707179245621 149.85522070639857 -240.4502288371578

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
