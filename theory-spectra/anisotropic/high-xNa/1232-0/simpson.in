spinsys {

channels 23Na
nuclei 23Na

shift 1 538.176p -120.19815541446071p 0.5893767515114743 123.56080674535411 117.83196191955643 12.876929954153473
quadrupole 1 2 -4748984.411164044 0.7930150433047399 140.37310834148354 113.28016996407094 192.89335803251288

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
