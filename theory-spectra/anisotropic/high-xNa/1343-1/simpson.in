spinsys {

channels 23Na
nuclei 23Na

shift 1 572.6850000000001p -104.68599701911697p 0.593135529222493 -178.06263229771352 172.31072649784426 -136.22538823379338
quadrupole 1 2 -4345914.235988543 0.1891574596187113 290.4262563528119 119.72262755237334 66.2184463922012

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
