spinsys {

channels 23Na
nuclei 23Na

shift 1 496.616p 104.13454358069778p 0.5719851018330098 -24.178823186730817 126.97865300233484 14.542981820848322
quadrupole 1 2 -874381.6915101673 0.5005596055560705 -19.11440723695049 117.24346149411811 59.60924332819535

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
