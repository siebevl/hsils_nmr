spinsys {

channels 23Na
nuclei 23Na

shift 1 685.3706666666667p 197.38742590898897p 0.7138277009750685 98.84220527649609 119.00878263374923 -63.34138587737099
quadrupole 1 2 -2673601.3914906927 0.660777903803043 84.2560462496688 123.42060506173856 43.18670281640589

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
