spinsys {

channels 23Na
nuclei 23Na

shift 1 625.9483333333334p 67.04931350945927p 0.5910058528772193 52.84181565751817 95.38910291442822 -11.800629779604549
quadrupole 1 2 3108067.9939883826 0.5501211059279167 -93.79970281033094 67.46723383138298 128.4702746951002

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
