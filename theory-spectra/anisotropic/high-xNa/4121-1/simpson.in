spinsys {

channels 23Na
nuclei 23Na

shift 1 493.1586666666667p -182.58965289744242p 0.19271622817905693 51.70381495587909 76.84010827137978 53.0428173803619
quadrupole 1 2 3845172.832047153 0.26083324294742877 150.75826029132966 72.53110314119095 97.32303736204649

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
