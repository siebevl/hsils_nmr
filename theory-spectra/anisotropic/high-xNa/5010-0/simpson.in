spinsys {

channels 23Na
nuclei 23Na

shift 1 572.8616666666666p -21.802840244041818p 0.5269033459811656 -153.34883276699108 36.35521399445581 98.74677404349559
quadrupole 1 2 4629790.637318752 0.3865508035821349 92.89965527658296 51.64871920034741 -80.06762699122379

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
