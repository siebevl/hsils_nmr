spinsys {

channels 23Na
nuclei 23Na

shift 1 519.2676666666667p 77.23534611151054p 0.5988301375725575 -21.46432241097006 101.85056102788913 64.72979251990547
quadrupole 1 2 -5161047.859767879 0.6866347856116713 -20.573551513067738 27.990120299565287 36.38850539066517

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
