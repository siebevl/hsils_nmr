spinsys {

channels 23Na
nuclei 23Na

shift 1 565.9856666666666p -119.68031808233282p 0.5031002180977814 -76.8336619073276 62.59271402001683 160.0615866181408
quadrupole 1 2 -2870116.387708311 0.11759428141693205 -95.72269712684225 136.7349788148259 -260.4067345181552

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
