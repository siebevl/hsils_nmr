spinsys {

channels 23Na
nuclei 23Na

shift 1 553.14p 17.00225989603526p 0.5535389310123839 177.0381967401191 58.17907907646992 25.30464504122547
quadrupole 1 2 -3093416.26442616 0.2786221135259241 149.4470135296124 72.68628407114234 50.851593481706324

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
