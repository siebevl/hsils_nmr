spinsys {

channels 23Na
nuclei 23Na

shift 1 645.8723333333334p 264.7687665172647p 0.18965775399569024 41.84641827145428 150.04266764982208 -55.59080223696125
quadrupole 1 2 -4090954.5591035318 0.6166450790138787 -73.74305310784439 68.25106225030213 4.404593873336792

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
