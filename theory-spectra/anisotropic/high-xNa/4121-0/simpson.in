spinsys {

channels 23Na
nuclei 23Na

shift 1 640.2956666666666p 70.87071319354709p 0.7933216309747027 -85.36959094440613 41.278499848145934 52.41655382957625
quadrupole 1 2 3730125.763713074 0.961407357612723 -97.62981145566093 113.61636960024288 -230.64696832921686

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
