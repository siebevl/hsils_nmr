spinsys {

channels 23Na
nuclei 23Na

shift 1 525.3866666666667p -116.94664257620714p 0.7137948424116524 56.8946296921828 129.7227496860921 74.72016300442262
quadrupole 1 2 -3852187.9231344694 0.6667665306031295 -24.71030139642913 78.87061790483826 16.501053327794693

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
