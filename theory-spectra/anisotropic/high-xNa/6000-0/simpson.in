spinsys {

channels 23Na
nuclei 23Na

shift 1 531.7503333333333p 76.50017333793869p 0.8160739265436647 -14.103417949917029 117.29893368927837 42.60381832484809
quadrupole 1 2 2677953.9624838955 0.946171887797256 186.34189989289254 33.33453016912931 -80.09971124846794

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
