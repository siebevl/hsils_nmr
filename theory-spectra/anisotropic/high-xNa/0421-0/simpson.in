spinsys {

channels 23Na
nuclei 23Na

shift 1 551.308p -90.21758015120417p 0.6395820473923844 -124.16312748713385 39.351242534034796 60.21275575799592
quadrupole 1 2 3149477.232795934 0.6327730526708721 -103.84649214357987 73.4144727335653 81.17346915727848

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
