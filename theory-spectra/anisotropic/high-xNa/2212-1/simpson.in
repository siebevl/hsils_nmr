spinsys {

channels 23Na
nuclei 23Na

shift 1 608.477p -127.18460354304746p 0.5036622788505133 264.08611782703423 127.93832202644947 91.36505755603174
quadrupole 1 2 4255253.323008386 0.8211568663218718 153.2422364265456 67.48574992026752 20.230693976646368

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
