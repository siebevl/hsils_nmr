spinsys {

channels 23Na
nuclei 23Na

shift 1 1017.1576666666666p -446.42764295502354p 0.7539830213834685 -29.119718355029484 131.0638914167925 28.912125982712194
quadrupole 1 2 5729779.1981873745 0.7620028006588605 163.59597641322108 61.95862046779317 44.990240964120744

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
