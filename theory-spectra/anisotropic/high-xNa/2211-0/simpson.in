spinsys {

channels 23Na
nuclei 23Na

shift 1 533.1026666666667p -80.9421986040528p 0.489917512727554 8.588093515392453 48.81406706199649 92.17087146183772
quadrupole 1 2 -4338523.737940589 0.5941538404997582 58.86286084694445 144.1584929814767 -22.627209535211332

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
