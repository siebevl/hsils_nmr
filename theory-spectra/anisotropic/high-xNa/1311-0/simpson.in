spinsys {

channels 23Na
nuclei 23Na

shift 1 600.1396666666666p -66.9075927625419p 0.18991061303674953 -95.72792604616197 117.67608971881587 -27.125849821311466
quadrupole 1 2 -4240214.892170053 0.3602574721304806 -38.03462924173424 48.43376842829609 102.65566655931615

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
