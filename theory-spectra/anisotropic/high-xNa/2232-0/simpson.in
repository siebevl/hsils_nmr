spinsys {

channels 23Na
nuclei 23Na

shift 1 524.2923333333333p 66.9219733694772p 0.936978878111963 312.0261988954337 116.65925219096741 47.32484332597401
quadrupole 1 2 2045824.8618158833 0.8605224586148545 51.110806510622794 121.57144202510194 -113.65521934297396

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
