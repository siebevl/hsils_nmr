spinsys {

channels 23Na
nuclei 23Na

shift 1 615.9253333333335p 90.6966416093472p 0.908156739060524 67.96568828018394 142.4026129262698 -19.65083005368507
quadrupole 1 2 -3688511.0759555483 0.2618088909300816 71.80009886727359 125.18288996292668 25.726027441923986

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
