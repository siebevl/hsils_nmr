spinsys {

channels 23Na
nuclei 23Na

shift 1 600.6163333333334p 41.304132328577225p 0.9353275783850382 25.622313071271368 153.65704890457448 -59.407066684712426
quadrupole 1 2 -4410742.899074171 0.651226571850577 -155.4677484008005 26.165417099091712 164.9783656732201

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
