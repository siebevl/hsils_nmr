spinsys {

channels 23Na
nuclei 23Na

shift 1 607.821p -67.08414886432395p 0.9343380889107493 68.08405660986176 66.47444167622577 0.8632930247097069
quadrupole 1 2 -4849293.995289563 0.23601745797457185 -140.89897858205734 15.225678322795284 144.40621052304618

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
