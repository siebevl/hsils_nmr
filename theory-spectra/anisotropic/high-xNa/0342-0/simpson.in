spinsys {

channels 23Na
nuclei 23Na

shift 1 562.8196666666666p -61.0450361981763p 0.7050639633526915 80.0692670183842 140.4942386711381 -6.506234987920445
quadrupole 1 2 4255840.676693301 0.8776107631362455 -11.952311161920365 80.4348935906141 4.862543970843722

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
