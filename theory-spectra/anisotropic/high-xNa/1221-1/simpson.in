spinsys {

channels 23Na
nuclei 23Na

shift 1 569.2283333333334p 64.14950346054448p 0.5875201958813807 32.56070469800446 26.383469552692457 -12.07855305420556
quadrupole 1 2 -6665508.719574488 0.9704545003533419 122.16048517519357 135.95478018284737 -8.57297299620628

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
