spinsys {

channels 23Na
nuclei 23Na

shift 1 554.1663333333333p -95.52427172240166p 0.7711449320665277 -163.0394436654117 164.1284084491249 -119.53596827495326
quadrupole 1 2 5165891.574273457 0.4658519636043847 37.926124366874554 122.40136423679886 -151.3392430426042

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
