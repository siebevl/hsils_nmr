spinsys {

channels 23Na
nuclei 23Na

shift 1 564.339p -94.53520776463922p 0.9138966750611256 -127.58165430755858 50.90489502632287 179.4131059795779
quadrupole 1 2 2003121.5650148524 0.5165413875428988 26.817046878697457 84.52218173551967 -20.21264798731539

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
