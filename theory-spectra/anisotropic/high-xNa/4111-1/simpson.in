spinsys {

channels 23Na
nuclei 23Na

shift 1 583.4933333333333p -35.662454712105045p 0.2646485418332773 -17.29626027422982 85.20405757168139 -53.1526762526476
quadrupole 1 2 -2339798.7962068208 0.5764179996113852 124.44924568828324 101.2644873940591 -73.9329140587333

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
