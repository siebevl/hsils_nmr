spinsys {

channels 23Na
nuclei 23Na

shift 1 572.9463333333333p -59.24274533317596p 0.9328098998495657 -53.91238612843283 71.5196845768444 150.09930443145873
quadrupole 1 2 3960554.6844423204 0.5815246980763821 -46.494078614224044 62.50740082892863 158.8872876375765

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
