spinsys {

channels 23Na
nuclei 23Na

shift 1 654.5533333333334p -82.09139370601201p 0.7869484276660098 -17.282515918995973 128.3721641322841 -248.36893623987885
quadrupole 1 2 -2233584.9192886604 0.25372177221569747 -62.57215476515958 104.78081447727651 -191.5614356343352

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
