spinsys {

channels 23Na
nuclei 23Na

shift 1 554.8033333333333p -11.53821178465978p 0.5871813257273423 134.9355501056462 61.563025507201544 -34.2247949008162
quadrupole 1 2 3608270.203600695 0.5259850412973086 -56.68946084105794 114.7942899763215 -247.09135538074995

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
