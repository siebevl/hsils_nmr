spinsys {

channels 23Na
nuclei 23Na

shift 1 611.2856666666667p 66.27519607157713p 0.7311965536177164 224.90371663712386 111.16308573348412 99.91837986293302
quadrupole 1 2 3127304.957492078 0.741741488111069 45.320552671193006 61.84004493265024 39.057139791873034

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
