spinsys {

channels 23Na
nuclei 23Na

shift 1 596.2723333333333p 28.798487720098514p 0.9683683357300801 7.078730624064308 41.491451673578425 82.56877823651868
quadrupole 1 2 4855885.860846714 0.6800022661730402 70.30854411324334 67.8948015013647 -9.811268392779727

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
