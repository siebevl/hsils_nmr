spinsys {

channels 23Na
nuclei 23Na

shift 1 488.63533333333334p 104.69213501277446p 0.7664807664433135 145.23250029388285 55.91100537053783 86.11053070329902
quadrupole 1 2 -3989682.419095506 0.26934345046833613 71.06656843823147 12.743947770945526 -129.9453698723919

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
