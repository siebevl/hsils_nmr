spinsys {

channels 23Na
nuclei 23Na

shift 1 771.5453333333334p -174.4715239440157p 0.28507741894545363 147.20295854719473 40.827879367094866 -100.24895311471677
quadrupole 1 2 -3708850.9811182227 0.6602660885479019 -148.99397541395322 37.796224584785485 117.17870823221389

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
