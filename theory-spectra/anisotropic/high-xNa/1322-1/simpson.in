spinsys {

channels 23Na
nuclei 23Na

shift 1 576.006p 121.30593210324596p 0.7299437284435575 32.43451789239005 131.21137103081307 -185.9968978707565
quadrupole 1 2 2962608.3170723366 0.5314071362595982 130.32137513082986 87.4289163821712 -43.37127701512514

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
