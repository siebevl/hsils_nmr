spinsys {

channels 23Na
nuclei 23Na

shift 1 585.292p 115.58502017156516p 0.8233612332522054 79.85750705521289 106.86476199647477 -116.79727608614047
quadrupole 1 2 1496668.9979277828 0.8712618009963577 -56.765806545673776 109.36172796606705 19.969117295677105

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
