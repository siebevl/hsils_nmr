spinsys {

channels 23Na
nuclei 23Na

shift 1 566.3033333333334p -15.63512817188651p 0.8694389844878229 67.08916903674003 51.709204981204465 119.60158054249516
quadrupole 1 2 -2710597.526772986 0.4984600020215874 178.47955505378016 67.04672596282198 -22.552359506940796

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
