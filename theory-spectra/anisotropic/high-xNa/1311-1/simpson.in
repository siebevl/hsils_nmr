spinsys {

channels 23Na
nuclei 23Na

shift 1 666.349p 154.16006839857528p 0.30362823182179066 53.03074231033956 124.64944803059275 -47.25940480755342
quadrupole 1 2 -3168855.5996549353 0.2941299433047699 146.94313099087708 163.5866960109638 -95.1986526620766

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
