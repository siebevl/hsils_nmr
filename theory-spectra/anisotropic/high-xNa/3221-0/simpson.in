spinsys {

channels 23Na
nuclei 23Na

shift 1 520.157p 111.17224182209421p 0.3786591222914375 130.78164403132962 86.59111142260332 58.294388233183646
quadrupole 1 2 -3648653.332395434 0.3994801407659244 -23.455956850332335 82.3708787035974 -43.373622192670126

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
