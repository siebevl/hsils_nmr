spinsys {

channels 23Na
nuclei 23Na

shift 1 555.75p 170.4852287459771p 0.5712285660997907 181.03766054513977 97.44915167733569 147.20887041809416
quadrupole 1 2 -2667861.6897689523 0.19480282068533764 -1.7602288997949909 63.05877025579326 -80.55806522552608

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
