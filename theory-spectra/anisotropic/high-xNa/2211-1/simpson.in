spinsys {

channels 23Na
nuclei 23Na

shift 1 541.8713333333334p 176.72310461067144p 0.9811421097382919 151.53417318016085 105.74702577652091 142.68195442257033
quadrupole 1 2 3210488.473052997 0.847720900982376 163.65317088714104 44.751155042034675 -89.36907358023339

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
