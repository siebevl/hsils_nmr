spinsys {

channels 23Na
nuclei 23Na

shift 1 535.312p 74.44570732786443p 0.7731106825312575 138.43868545366757 81.59224238170403 88.2472050934801
quadrupole 1 2 4231125.695721587 0.3659443056343465 -179.79022832633277 110.96980002747573 -158.0767014420138

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
