spinsys {

channels 23Na
nuclei 23Na

shift 1 660.4623333333334p -119.48195462540085p 0.20803934837375299 -187.56481298068476 25.195988518788436 147.40730179298123
quadrupole 1 2 -4160917.748099209 0.31989137261300454 176.42483907023345 92.21742385396182 152.00298645626455

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
