spinsys {

channels 23Na
nuclei 23Na

shift 1 540.7660000000001p -71.22549612184191p 0.43588904621207014 -82.32285915354944 52.06132236985013 66.89123467276976
quadrupole 1 2 -3995980.1964485263 0.7910032432751071 11.265828855162896 109.6073991747829 -69.8131258578347

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
