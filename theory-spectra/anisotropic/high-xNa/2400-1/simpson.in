spinsys {

channels 23Na
nuclei 23Na

shift 1 433.2266666666667p 157.87708603204482p 0.5898128287908878 150.1345734216085 58.48979535645287 13.394893325708496
quadrupole 1 2 2314532.621624944 0.979144872567063 -81.58157346582226 16.776700390537957 -3.3553962983981096

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
