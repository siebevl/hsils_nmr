spinsys {

channels 23Na
nuclei 23Na

shift 1 825.4446666666666p -284.95239568329464p 0.5866731530137481 129.65405379881577 32.39248570706804 -179.284068559104
quadrupole 1 2 4619918.26158674 0.20245031613286418 41.217590020123374 162.47071737183333 -11.98107195524878

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
