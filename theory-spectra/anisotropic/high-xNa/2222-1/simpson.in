spinsys {

channels 23Na
nuclei 23Na

shift 1 614.8416666666667p -65.4540744721747p 0.7134335954313882 -76.54254903062576 89.53993524215767 120.437540483534
quadrupole 1 2 2946769.478248671 0.895750973144354 -77.54782958094438 36.81455343709334 59.78233904322816

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
