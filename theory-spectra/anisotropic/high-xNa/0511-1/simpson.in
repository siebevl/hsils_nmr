spinsys {

channels 23Na
nuclei 23Na

shift 1 554.1370000000001p 20.94519773332134p 0.6276173270207324 80.64891755432932 63.04210551670127 2.49670610685735
quadrupole 1 2 -4161327.380272006 0.6204836726044145 84.92554401193345 62.1914850883496 -71.10276773428774

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
