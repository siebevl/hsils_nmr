spinsys {

channels 23Na
nuclei 23Na

shift 1 647.0023333333334p -105.5970359404927p 0.47984934974747373 129.98972058624958 23.71854101693806 75.7388723093464
quadrupole 1 2 4966013.794201549 0.28188193432912495 119.04771304005163 17.157097516064958 40.8334304975485

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
