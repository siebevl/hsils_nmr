spinsys {

channels 23Na
nuclei 23Na

shift 1 554.8473333333333p 13.984192959727048p 0.22638406856381954 -35.64941357136024 79.20243999507409 -24.614286708901236
quadrupole 1 2 -3375445.817969042 0.4672007897458853 130.84801335533342 99.21788361820238 -5.35904999492552

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
