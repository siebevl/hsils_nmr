spinsys {

channels 23Na
nuclei 23Na

shift 1 556.0093333333333p 21.747513206214308p 0.15734758431840412 4.162382675575214 24.03484267324133 94.3274614908437
quadrupole 1 2 -4392416.106768356 0.2678246700369932 7.418264485459789 27.712315946904145 -8.038795192035865

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
