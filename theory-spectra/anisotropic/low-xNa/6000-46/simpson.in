spinsys {

channels 23Na
nuclei 23Na

shift 1 556.1453333333334p 3.267848367859945p 0.8103703935240385 11.774264795834386 87.98838618706439 -16.565628717829927
quadrupole 1 2 -1377345.425241336 0.9430791083886301 195.84674581564204 90.68380197341865 110.07824608389512

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
