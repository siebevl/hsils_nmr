spinsys {

channels 23Na
nuclei 23Na

shift 1 560.1576666666666p -8.932322926946123p 0.1588255362460648 39.77910564333929 83.05217333849164 -115.45237377609249
quadrupole 1 2 2878009.3081704667 0.28741686380689996 -141.2187425969771 88.34804168308223 200.69315842909737

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
