spinsys {

channels 23Na
nuclei 23Na

shift 1 548.7726666666666p 12.076507213266115p 0.8657472343124926 125.88207083398474 36.578970229255724 -82.24991407808028
quadrupole 1 2 -3194660.1803045925 0.8889499774525138 141.25067257207576 17.319842205251526 -197.80138808320774

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
