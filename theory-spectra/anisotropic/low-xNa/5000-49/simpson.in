spinsys {

channels 23Na
nuclei 23Na

shift 1 566.164p 18.486246433663304p 0.6415583403353652 155.52589330286435 89.64932093134077 101.55314266696575
quadrupole 1 2 4619562.546766743 0.8338574305151436 250.03201859755677 78.23706735619567 2.338662384435409

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
