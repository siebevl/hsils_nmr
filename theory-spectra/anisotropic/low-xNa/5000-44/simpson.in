spinsys {

channels 23Na
nuclei 23Na

shift 1 555.4756666666666p -9.975992953223795p 0.23007476148552464 -6.287889858310251 99.62380425462861 39.27208905382363
quadrupole 1 2 3654409.847121056 0.43270623376599004 -13.072493292025202 102.43903855209676 76.10829594095318

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
