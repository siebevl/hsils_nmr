spinsys {

channels 23Na
nuclei 23Na

shift 1 568.6916666666667p 10.324024162236356p 0.7531124781614329 133.10724941573537 41.829632544355285 -115.02750133024057
quadrupole 1 2 -2914674.839938153 0.6987262904195262 -46.36002320448733 136.53988833105268 -282.53460827948055

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
