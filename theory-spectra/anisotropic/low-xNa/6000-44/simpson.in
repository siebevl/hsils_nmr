spinsys {

channels 23Na
nuclei 23Na

shift 1 555.6153333333333p -13.076022643251159p 0.5278521554125756 8.298404783581349 86.08866576275732 -51.940437822699614
quadrupole 1 2 3456811.0839519985 0.41990853972731995 13.763327015164451 89.02231660813491 29.767456025759774

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
