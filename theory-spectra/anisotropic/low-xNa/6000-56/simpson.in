spinsys {

channels 23Na
nuclei 23Na

shift 1 546.677p -7.636950173596309p 0.8488274903743417 52.38048992846135 95.79533333788385 36.141263825705046
quadrupole 1 2 -2987738.482577286 0.42263473127266943 150.623980041716 132.79405828121546 16.826747651614266

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
