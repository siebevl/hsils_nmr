spinsys {

channels 23Na
nuclei 23Na

shift 1 538.0500000000001p -8.320177932523771p 0.43224593566305797 -0.6873788633671943 30.334825672387915 46.14088563105126
quadrupole 1 2 2105372.8546596863 0.3983461714655354 226.17748833573157 137.5014797856343 32.23070288479593

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
