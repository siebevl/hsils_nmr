spinsys {

channels 23Na
nuclei 23Na

shift 1 552.1283333333333p -9.916048446524428p 0.8515468486071812 47.901584701881944 57.422693322912686 113.01884578216612
quadrupole 1 2 2867712.682899767 0.7833246860603148 65.7812663378209 82.5067235630148 6.818269159558743

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
