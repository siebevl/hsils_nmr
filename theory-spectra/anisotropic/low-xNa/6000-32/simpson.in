spinsys {

channels 23Na
nuclei 23Na

shift 1 553.7399999999999p 5.539449660222923p 0.1668923841713715 51.681398496574225 62.06496061332154 45.72719112596837
quadrupole 1 2 -1819996.005547647 0.36248028936585436 44.67701180389649 62.74670028322605 -66.67166640634514

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
