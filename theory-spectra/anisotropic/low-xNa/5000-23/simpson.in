spinsys {

channels 23Na
nuclei 23Na

shift 1 540.419p 17.411699572424062p 0.831218358750301 -37.47552409920834 116.69597002689673 0.6386443580678535
quadrupole 1 2 -2751727.6786855855 0.9652244019977629 -31.374934767137525 123.0763951840177 -289.52219400227284

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
