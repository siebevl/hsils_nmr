spinsys {

channels 23Na
nuclei 23Na

shift 1 548.9753333333333p 18.85619089969494p 0.43055852675631145 282.88450520818037 108.29585427181765 20.24947818597427
quadrupole 1 2 -3708217.6472210903 0.9349320701315549 -69.64430151912569 106.35485849355089 -252.18950440002254

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
