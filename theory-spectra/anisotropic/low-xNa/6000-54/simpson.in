spinsys {

channels 23Na
nuclei 23Na

shift 1 551.587p -12.958190645546816p 0.43151039171083455 57.63707024103055 81.15562625746549 -114.84912802578147
quadrupole 1 2 3293262.5274313972 0.7051818711439922 -123.0568735561838 109.97216535214532 -144.9157571149062

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
