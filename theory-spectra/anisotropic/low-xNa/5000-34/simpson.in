spinsys {

channels 23Na
nuclei 23Na

shift 1 561.2276666666667p 10.24566198118805p 0.42657922796405817 188.25249878336527 91.39920615393268 98.15955940365957
quadrupole 1 2 -2989698.624711476 0.762627166772527 7.45258808165563 75.62951878650611 10.413156784716184

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
