spinsys {

channels 23Na
nuclei 23Na

shift 1 544.3393333333333p -13.51850073699211p 0.7461976630744929 33.59057888922639 103.31839525395625 -98.35269687825125
quadrupole 1 2 4767083.807845023 0.3380526535608484 30.005986446615953 109.86606703433463 -23.232871065325725

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
