spinsys {

channels 23Na
nuclei 23Na

shift 1 554.3266666666667p 10.644472115000173p 0.9939184400073632 210.68178975193405 110.92914305568023 14.299734594051746
quadrupole 1 2 -2961358.8606742416 0.6679409769424193 211.49900660621415 111.14207458884894 101.84074913765275

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
