spinsys {

channels 23Na
nuclei 23Na

shift 1 546.933p -12.878021878556183p 0.9015959482105359 -0.6026226869813572 104.71514944654733 -113.42186964233662
quadrupole 1 2 4776781.479427982 0.46138346807237784 6.071543148711161 94.5274898794375 -27.760056758789283

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
