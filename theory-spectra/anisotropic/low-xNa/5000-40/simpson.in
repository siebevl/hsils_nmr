spinsys {

channels 23Na
nuclei 23Na

shift 1 547.001p 14.596908074042858p 0.6696671075177177 145.92748702701354 99.49887505727898 101.06541311228888
quadrupole 1 2 5012719.5943314945 0.8743427053803688 231.98440204009782 65.11369663618441 7.945298435870946

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
