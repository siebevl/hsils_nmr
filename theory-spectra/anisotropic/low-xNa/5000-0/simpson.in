spinsys {

channels 23Na
nuclei 23Na

shift 1 550.3823333333333p 8.91994400686887p 0.4198281134613817 131.99086069766392 85.52765242923732 81.1168321343091
quadrupole 1 2 1875844.48361573 0.9940256097714955 221.8555947152075 56.89802065539455 -9.675716489149428

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
