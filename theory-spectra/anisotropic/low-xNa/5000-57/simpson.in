spinsys {

channels 23Na
nuclei 23Na

shift 1 549.8293333333332p -7.961732772052149p 0.4681513174267648 55.28136931352848 44.188453574495 16.680596659595608
quadrupole 1 2 2576147.975920557 0.38067493378548045 41.5364212989966 54.552201228372134 -46.9330805635883

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
