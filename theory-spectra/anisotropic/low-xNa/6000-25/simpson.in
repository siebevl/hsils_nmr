spinsys {

channels 23Na
nuclei 23Na

shift 1 558.4603333333333p 7.866898335802034p 0.2916478487932765 33.943257204332696 112.38409434818647 -3.3401489278164016
quadrupole 1 2 -1983198.525579963 0.44599059001636016 -168.62755986078454 46.76343187469505 130.35078748275586

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
