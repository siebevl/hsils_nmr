spinsys {

channels 23Na
nuclei 23Na

shift 1 555.6303333333333p -16.78379065513741p 0.6019438277535037 87.8242694301981 109.66600607908246 39.84885714029123
quadrupole 1 2 5628062.488027403 0.29850353422317855 83.67760138302326 98.84876698368271 -44.61286247693118

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
