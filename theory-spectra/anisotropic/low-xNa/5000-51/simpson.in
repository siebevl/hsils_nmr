spinsys {

channels 23Na
nuclei 23Na

shift 1 551.0316666666668p 13.998566580370682p 0.5148814356125796 235.60578922706546 123.90832951765265 109.46845225269126
quadrupole 1 2 -3055022.7410078757 0.6428651577792922 -125.82809840033403 123.76868944361831 -156.98843392542307

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
