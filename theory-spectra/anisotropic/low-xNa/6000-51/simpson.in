spinsys {

channels 23Na
nuclei 23Na

shift 1 549.79p 7.287280796773757p 0.6534975937967762 17.786979825149075 63.67008580545757 50.412689419954866
quadrupole 1 2 -946075.9585548773 0.9622837041639134 16.677642172798947 82.78871957131074 -8.829093468693682

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
