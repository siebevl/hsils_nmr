spinsys {

channels 23Na
nuclei 23Na

shift 1 549.6213333333334p 10.864129367735282p 0.7668613274436878 -105.32810084299946 73.17534448601056 40.237850218326614
quadrupole 1 2 2114453.4298119424 0.8440416740991898 160.56794147254058 63.26760742705902 19.050963596287886

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
