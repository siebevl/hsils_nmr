spinsys {

channels 23Na
nuclei 23Na

shift 1 559.2496666666666p -5.880089915329639p 0.670269316993301 -131.71635525109855 149.35671281991017 -227.18004002732448
quadrupole 1 2 2687282.144735221 0.3756148245997303 -104.64598202635271 152.21567099223213 -85.48668020065719

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
