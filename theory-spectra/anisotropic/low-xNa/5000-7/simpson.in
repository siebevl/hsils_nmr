spinsys {

channels 23Na
nuclei 23Na

shift 1 567.241p 19.384792861350736p 0.3094465878616911 -173.1415098903232 76.80395122791144 139.72640206612482
quadrupole 1 2 -3917039.5140430923 0.13964480968522175 -178.16866224845566 75.6512452971941 127.77493234146878

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
