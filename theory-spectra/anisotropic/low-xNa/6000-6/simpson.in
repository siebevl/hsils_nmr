spinsys {

channels 23Na
nuclei 23Na

shift 1 549.2379999999999p 12.637736129205905p 0.7044130301016802 152.2367295247559 138.3686829022913 111.58796167180931
quadrupole 1 2 3450058.3295765063 0.888350132715166 27.63023189806016 119.78772403505478 -58.33019240454889

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
