spinsys {

channels 23Na
nuclei 23Na

shift 1 547.9733333333334p -8.164629280609308p 0.42544266597079583 -85.11526475359659 89.09097406841273 78.72346621687987
quadrupole 1 2 1791670.4823884382 0.48010469727616667 104.32839951760822 72.63505995721889 -114.9059643074157

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
