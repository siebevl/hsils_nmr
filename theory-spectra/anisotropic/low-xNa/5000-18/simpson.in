spinsys {

channels 23Na
nuclei 23Na

shift 1 543.3883333333333p 8.870262364484915p 0.934073511978791 264.26197767983984 104.03276102777355 42.657372288576376
quadrupole 1 2 2456312.088788411 0.9383886073464468 -171.38559530565968 41.22219424747878 187.62165350550964

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
