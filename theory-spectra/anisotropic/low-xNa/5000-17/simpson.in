spinsys {

channels 23Na
nuclei 23Na

shift 1 551.224p 13.057528996934781p 0.9709098682881455 -118.84943645548883 55.60060383683362 95.67404280547638
quadrupole 1 2 3641715.208509306 0.9379683121868337 -23.143601657578902 82.22646448336434 -27.646483890523292

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
