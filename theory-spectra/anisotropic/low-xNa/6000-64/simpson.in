spinsys {

channels 23Na
nuclei 23Na

shift 1 549.6759999999999p -8.479584641839057p 0.7926190780270587 -16.59587759827654 51.09483577432879 217.8587186232003
quadrupole 1 2 1722938.6966768636 0.6802979019896236 155.25201509026326 135.65049949744827 31.55857647535994

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
