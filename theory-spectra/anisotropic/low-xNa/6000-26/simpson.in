spinsys {

channels 23Na
nuclei 23Na

shift 1 555.9233333333333p -3.8037510465887103p 0.6321843716147677 -53.43756857446791 62.00938919510414 101.46317949606264
quadrupole 1 2 -1189638.9744275426 0.8720129270140743 84.59726232956125 77.75132219536393 -86.05630128120312

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
