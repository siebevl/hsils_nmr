spinsys {

channels 23Na
nuclei 23Na

shift 1 549.5596666666667p -11.146054137642295p 0.9345356044413207 22.41688714640758 33.50459229415821 72.56547178139475
quadrupole 1 2 4036713.8858060767 0.7898940578934226 25.735287424022342 35.480904689179816 -29.695023239222717

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
