spinsys {

channels 23Na
nuclei 23Na

shift 1 558.614p -16.8374669465724p 0.7816720362511411 -31.96322278750705 147.62871466906944 -116.32588448778259
quadrupole 1 2 4202933.706481795 0.9359485958299893 147.52989588818713 27.529622704993066 -149.2793026041967

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
