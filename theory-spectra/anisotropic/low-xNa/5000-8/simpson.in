spinsys {

channels 23Na
nuclei 23Na

shift 1 548.8716666666666p 11.845549020089416p 0.7449042907003006 76.34600919932926 51.78740450667717 17.670365537509575
quadrupole 1 2 2661801.843049939 0.40263717326235954 132.36449797093434 126.4516007148481 -64.56059526060248

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
