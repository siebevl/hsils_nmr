spinsys {

channels 23Na
nuclei 23Na

shift 1 551.1350000000001p -13.523607446598135p 0.6690948521530174 -125.02039945635177 148.11990145312595 -184.52323043300245
quadrupole 1 2 3592720.446896027 0.8414167359102106 50.570358143708354 25.264950046109306 -79.58921421902883

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
