spinsys {

channels 23Na
nuclei 23Na

shift 1 556.294p -11.045849307351165p 0.8182718377341743 -62.83723831819253 81.44271787216984 186.02181459082502
quadrupole 1 2 2888750.6732717487 0.710553327732083 -78.55112195854532 81.20200959047827 98.64636349702337

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
