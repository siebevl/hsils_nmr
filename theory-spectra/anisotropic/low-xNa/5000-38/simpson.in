spinsys {

channels 23Na
nuclei 23Na

shift 1 551.119p 11.522344881016654p 0.47964858577550396 78.52667714733752 12.024933347236564 -48.071891571624015
quadrupole 1 2 -3244354.33456785 0.06482451084226246 160.1180822323972 172.1257602701717 -40.86838360875461

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
