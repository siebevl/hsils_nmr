spinsys {

channels 23Na
nuclei 23Na

shift 1 554.4446666666666p -14.720119629422772p 0.9155724478342447 16.532501012825687 33.73697458677804 120.68171449282809
quadrupole 1 2 4797283.52374222 0.5487296975885144 195.30057054146943 141.144374790865 149.04725122311748

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
