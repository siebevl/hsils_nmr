spinsys {

channels 23Na
nuclei 23Na

shift 1 554.8563333333334p -14.287842888205734p 0.8634922580193226 129.32260950776862 156.7605061323007 178.98526670697672
quadrupole 1 2 3915924.4070644905 0.33157198491859646 136.41404047977477 161.98298432132717 -98.56988866595054

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
