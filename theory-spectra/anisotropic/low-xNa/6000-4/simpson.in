spinsys {

channels 23Na
nuclei 23Na

shift 1 549.6056666666667p 10.359024934681429p 0.7276702695648971 37.32978840680042 140.73702835139548 -10.57554328462977
quadrupole 1 2 -2537077.2988320384 0.7557100397538475 39.83035883178805 139.6360546593874 -102.28993594130961

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
