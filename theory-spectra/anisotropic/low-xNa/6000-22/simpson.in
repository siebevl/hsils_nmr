spinsys {

channels 23Na
nuclei 23Na

shift 1 546.4979999999999p 11.125112617309544p 0.30068615829256823 -32.70957668501512 25.384963532271353 288.763568020613
quadrupole 1 2 -3041138.248852141 0.42127895936715776 147.40936732194947 147.79162263543643 23.811010494979527

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
