spinsys {

channels 23Na
nuclei 23Na

shift 1 554.6656666666667p -15.913454947052742p 0.9512288110575579 19.8617897010305 119.55073674512066 16.10853978058365
quadrupole 1 2 4258597.214374061 0.9908415095178522 221.73328067919883 69.2446683707239 -107.22930005356957

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
