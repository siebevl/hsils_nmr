spinsys {

channels 23Na
nuclei 23Na

shift 1 552.1113333333333p -11.00764001333717p 0.1583259425522361 -114.89953141060855 34.524804067658096 213.81928793272422
quadrupole 1 2 3380069.3534662332 0.32105701396769876 54.784029224245494 159.6713468524147 -137.60959721979717

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
