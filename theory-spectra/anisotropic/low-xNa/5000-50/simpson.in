spinsys {

channels 23Na
nuclei 23Na

shift 1 558.1866666666667p -5.8049520054689765p 0.7684714947939971 -39.47399624154242 91.58002045449638 -1.3007297556116617
quadrupole 1 2 -1468749.5109981224 0.9277428172464736 -103.8390564243831 25.09237328618829 31.601411954570743

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
