spinsys {

channels 23Na
nuclei 23Na

shift 1 555.8803333333333p -14.566579721367361p 0.767294879848147 -29.007171084549462 54.633508960624475 266.63379954138185
quadrupole 1 2 -4148087.777264791 0.9949778732403808 -122.5490084757638 87.18095394642816 61.224106999046356

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
