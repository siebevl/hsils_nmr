spinsys {

channels 23Na
nuclei 23Na

shift 1 560.046p -17.812476766011514p 0.2093124651847061 7.172583887991151 43.323786205360705 -44.79299370871134
quadrupole 1 2 4724132.910754418 0.25022186241846767 179.13473467460324 138.53556780690315 87.0525183550027

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
