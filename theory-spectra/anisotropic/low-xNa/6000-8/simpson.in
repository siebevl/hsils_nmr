spinsys {

channels 23Na
nuclei 23Na

shift 1 552.9700000000001p 6.969958044401285p 0.3173873387073699 196.39433574518017 125.17737010277017 35.97221295040668
quadrupole 1 2 -1991007.0120272846 0.49016208759389057 200.62919397978928 145.06901447412653 134.2417449380004

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
