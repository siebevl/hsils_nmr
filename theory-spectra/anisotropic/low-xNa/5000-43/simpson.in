spinsys {

channels 23Na
nuclei 23Na

shift 1 555.851p 8.541650071252812p 0.4386343746970547 -8.269400365679747 97.16766069839088 15.352011426246802
quadrupole 1 2 3176644.451934729 0.7518888648297599 182.5939404825395 162.3866768954606 -81.78823400099803

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
