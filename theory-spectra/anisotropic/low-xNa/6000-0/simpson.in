spinsys {

channels 23Na
nuclei 23Na

shift 1 544.382p 7.724037455480129p 0.8343835590230279 -25.340142562320324 48.185846094195945 -56.61269152734515
quadrupole 1 2 2340942.694176495 0.8713608973967674 -100.1331418593706 108.66407148565936 -138.39369256228395

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
