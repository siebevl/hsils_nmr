spinsys {

channels 23Na
nuclei 23Na

shift 1 560.2733333333333p -8.646453821218302p 0.9713484345545447 -17.501700543804507 134.16318683683693 -253.68953406222744
quadrupole 1 2 2838044.83948197 0.570975257648448 -18.90828142570263 139.50431228123023 -179.87330148399798

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
