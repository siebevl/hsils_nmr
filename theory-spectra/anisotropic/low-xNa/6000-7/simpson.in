spinsys {

channels 23Na
nuclei 23Na

shift 1 554.6529999999999p 12.546643222765093p 0.07609813607544536 -169.50591033409864 46.75451779687814 132.93009892765886
quadrupole 1 2 -3854865.876958945 0.6523817132124358 15.606039897007637 133.32539152011714 -53.859459299941385

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
