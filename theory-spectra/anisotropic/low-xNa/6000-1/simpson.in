spinsys {

channels 23Na
nuclei 23Na

shift 1 551.218p -11.615156327508505p 0.619930570970437 23.457500724533062 105.1536705331482 -2.349481345516084
quadrupole 1 2 3125555.9062923575 0.16639786898985284 -156.0982561735438 84.63193337572065 93.30930622190382

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
