spinsys {

channels 23Na
nuclei 23Na

shift 1 541.5433333333334p 4.08271969933124p 0.9232771435248636 115.01445235165299 126.88269891481109 -67.21228217439956
quadrupole 1 2 -1642611.681719783 0.8983259358009535 -77.94985049814728 64.08688638815684 -2.7375767976889502

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
