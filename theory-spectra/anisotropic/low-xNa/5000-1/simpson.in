spinsys {

channels 23Na
nuclei 23Na

shift 1 546.0883333333334p -20.878590941819386p 0.6876685464547804 232.6809001608939 109.82980590067665 72.13311021713074
quadrupole 1 2 5517585.496918801 0.4022069214678622 50.21990831931456 68.15659589438926 31.196656151470126

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
