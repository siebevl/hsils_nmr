spinsys {

channels 23Na
nuclei 23Na

shift 1 561.784p -10.940147393778716p 0.9498284598815292 37.025728536693435 52.7513211294665 42.377506502997676
quadrupole 1 2 -3033179.447789651 0.9906131914378091 93.36285175559519 123.7175476436296 -38.39130243356631

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
