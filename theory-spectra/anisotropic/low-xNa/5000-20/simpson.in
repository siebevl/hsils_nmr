spinsys {

channels 23Na
nuclei 23Na

shift 1 549.0356666666667p 6.106606077672723p 0.7041727279617267 97.35323221855971 114.74097571067566 -35.064944264363035
quadrupole 1 2 -1847401.0045225336 0.7011677719952742 116.11191639943014 115.24741191573831 44.71239187685679

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
