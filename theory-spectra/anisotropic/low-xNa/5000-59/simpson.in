spinsys {

channels 23Na
nuclei 23Na

shift 1 553.0693333333334p 7.409578577018692p 0.910802051415634 1.4882659416161963 23.137420876275776 -46.493434319726745
quadrupole 1 2 1999738.6468603043 0.13073321577311384 0.8678690274593069 88.42780581913352 23.195996135624544

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
