spinsys {

channels 23Na
nuclei 23Na

shift 1 562.5413333333335p -12.01679704728546p 0.4137633302509779 94.69105295040882 126.47081434561264 150.98163473726044
quadrupole 1 2 3376146.4549136437 0.6180198798437633 100.82324395130071 127.3827622965835 -101.78253263684361

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
