spinsys {

channels 23Na
nuclei 23Na

shift 1 558.1923333333333p -11.24890490514531p 0.9078379183757971 40.574918866382006 136.4341863875672 -50.899520330357646
quadrupole 1 2 3170751.302003476 0.7598827917618793 42.026022858009945 130.60897360102953 -160.26067735375838

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
