spinsys {

channels 23Na
nuclei 23Na

shift 1 564.8266666666667p -12.441138303036192p 0.32681781809201743 29.181922323425695 54.62308750202207 95.99364168987242
quadrupole 1 2 -2743550.5123126213 0.7762164116048178 129.3945688017326 90.31625702433034 -24.29965651656036

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
