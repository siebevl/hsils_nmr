spinsys {

channels 23Na
nuclei 23Na

shift 1 557.2963333333333p 13.296428808964567p 0.4501777210178544 -17.065420257999392 51.864663788853406 -58.37402345597123
quadrupole 1 2 -2944685.813533975 0.711350504633362 165.66175135969783 126.16124195442883 132.41077789848563

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
