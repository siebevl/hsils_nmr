spinsys {

channels 23Na
nuclei 23Na

shift 1 553.4293333333334p 10.954887977152566p 0.25572479815428933 -69.71324835908744 54.48790688329448 -17.758662200706187
quadrupole 1 2 -2719867.272082062 0.1037866655911339 102.55654076017821 124.66732624879197 137.08888986802353

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
