spinsys {

channels 23Na
nuclei 23Na

shift 1 546.9730000000001p -4.045588799787993p 0.34597186037138744 144.28026390861956 53.62849643645231 -95.3875354206931
quadrupole 1 2 -1298488.3455599586 0.8441655410801991 166.51856993839226 16.062211832441157 -51.71355916889803

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
