spinsys {

channels 23Na
nuclei 23Na

shift 1 546.7113333333333p -5.788894020750452p 0.44401263278617253 11.684823191262776 42.85162717610369 -21.68099014246189
quadrupole 1 2 3014856.653975108 0.15755359960361068 -1.4946557049775209 29.051798612745262 92.11413701509827

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
