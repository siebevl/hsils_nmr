spinsys {

channels 23Na
nuclei 23Na

shift 1 550.3266666666667p 18.56835036295729p 0.6096135271027959 56.003799257298496 43.003645241855374 -111.40358816748198
quadrupole 1 2 -4174800.5898403 0.6035849415880228 -127.51836131864057 133.3629059912599 -149.7428191597541

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
