spinsys {

channels 23Na
nuclei 23Na

shift 1 554.2273333333333p -18.449528827417375p 0.8208715169911975 94.9512522529609 99.65835196254442 90.12729094407037
quadrupole 1 2 4890182.147013677 0.5588245759154932 -92.49627948243594 76.15419009091197 4.591857679653573

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
