spinsys {

channels 23Na
nuclei 23Na

shift 1 562.3090000000001p 12.40764570780857p 0.30875700507788895 75.93422448945105 178.81993317422823 11.128969662755482
quadrupole 1 2 -2877583.5455442346 0.4655462191977047 -36.59635624353316 172.60100951112582 -211.45293804232946

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
