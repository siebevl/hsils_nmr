spinsys {

channels 23Na
nuclei 23Na

shift 1 546.694p -13.765801678793574p 0.6897652118051666 73.88428570111103 76.49760996285848 53.265602993535154
quadrupole 1 2 3682810.7134223203 0.37654007559809927 251.83643618144302 102.28159186659123 27.127882784022248

}


par {
    spin_rate        4000.0
    np               4096
    proton_frequency 500850000.0
    start_operator   I1x
    detect_operator  I1x
    method           direct
    crystal_file     rep256
    gamma_angles     208
    variable sw      gamma_angles*spin_rate
    verbose          1111
    variable tsw     1e6/sw
    variable rf      60000.0
    variable t45     2.05
}

proc pulseq {} {
    global par
    #pulse $par(t45) $par(rf) x
    acq_block {
    delay $par(tsw)
    }
}

proc main {} {
    global par
    set f [fsimpson]
    faddlb $f 100 0
    fzerofill $f 4096
    fft $f
    #fsave $f output.spe
    fsave $f output.txt -xreim
}
